# Local Docker Compose configuration. Copy this file to .env and replace
# every value before starting the stack. Never commit the resulting .env file.
DB_USER=nifty_app
DB_PASSWORD=change-this-to-a-long-random-password
DB_NAME=crypto_features
DB_SSLMODE=prefer
REDIS_SSL=false
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-to-a-long-random-password

# Keep false for a hosted API. Run src/run_hourly.py from a scheduler instead.
RUN_POLLER=false
